---
import Button from "../../components/ui/Button.astro";
import InputMail from "../../components/ui/InputMail.astro";

---
<!-- Subtítulo del formulario -->
        <h2 class="mb-subtitle">Acceso a Banca en Línea</h2>

        <!-- Caja de alerta, oculta por defecto, se muestra con JS -->
        <div class="mb-alert" id="mb-alert"></div>

        <!-- Campo de email -->
         <InputMail 
            label="D.N.I."
            placeholder="00.000.000"
            type="email"
            id="mb-email"
            />

        <!-- Campo de contraseña -->
         <InputMail
            label="Contraseña"
            placeholder="••••••••"
            id="mb-password"
            type="password"
         />


        <!-- Botón principal de ingreso -->
        <Button nombre="Ingresar" />


        <!-- Separador entre login normal y social -->
        <div class="mb-divider">o</div>

        <!-- Botón de login con Google -->
        <button class="mb-google">G &nbsp; Continuar con Google</button>

        <!-- Link de recuperación de contraseña -->
        <div class="mb-footer">
            <a href="/recovery-pwd">¿Olvidaste tu contraseña?</a>
        </div>


<script>


    document.addEventListener("DOMContentLoaded", () => {

        
        // Referencias a los elementos del DOM
        const btn     = document.getElementById("mb-btn") as HTMLButtonElement;
        const alertBox = document.getElementById("mb-alert") as HTMLDivElement;
        
        let intentos        = 0;
        const maxIntentos   = 3;
        // Tiempo de bloqueo en milisegundos
        const tiempoBloqueo = 5 * 60 * 1000;
        function bloquearBtn() {
            btn.disabled  = true;
            const fin     = Date.now() + tiempoBloqueo;

            const intervalo = setInterval(() => {
                const restante = Math.ceil((fin - Date.now()) / 1000);
                // limpieza de intervalo
                if (restante <= 0) {
                    clearInterval(intervalo);
                    btn.disabled    = false;
                    btn.textContent = "Ingresar";
                    intentos        = 0;
                    showAlert("Podés volver a intentarlo.", false);
                } else {
                    //  contador de minutos
                    const minutos  = Math.floor(restante / 60);
                    const segundos = restante % 60;
                    // Actualizar el texto del botón con el tiempo restante
                    btn.textContent = `Bloqueado ${minutos}:${segundos.toString().padStart(2, "0")}`;
                }
            }, 1000);
        }


        // Muestra un mensaje de alerta en el formulario
        // isError define si es error (rojo) o éxito (verde)
        function showAlert(message: string, isError: boolean = true) {
            alertBox.textContent   = message;
            alertBox.className     = "mb-alert " + (isError ? "error" : "success");
            alertBox.style.display = "block";
        }

        // Evento click del botón de ingreso
        btn.addEventListener("click", async () => {

            // Obtener valores de los campos
            const email    = (document.getElementById("mb-email") as HTMLInputElement).value.trim();
            const password = (document.getElementById("mb-password") as HTMLInputElement).value.trim();

            // Validación básica: campos vacíos
            if (!email || !password) {
                showAlert("Por favor completá todos los campos.");
                return;
            }

            // Deshabilitar botón mientras espera respuesta para evitar doble click
            btn.disabled     = true;
            btn.textContent  = "Verificando...";

            try {
                // Llamada a la API de FastAPI
                const response = await fetch("http://127.0.0.1:8000/api/login", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ email, password })
                });

                // Parsear respuesta de la API
                const data = await response.json();

                if (response.ok) {
                    // Login exitoso
                    showAlert(`Bienvenido/a, ${data.name}!`, false);
                    // Redirigir al dashboard una vez implementado
                    // window.location.href = "/dashboard";
                } else {
                    intentos++;
                    if (intentos >= maxIntentos) {
                        showAlert("Demasiados intentos. Bloqueado por 5 minutos.");
                        bloquearBtn();
                    } else {
                        const restantes = maxIntentos - intentos;
                        showAlert(`Credenciales inválidas. Te quedan ${restantes} intento${restantes > 1 ? "s" : ""}.`);
                        btn.disabled    = false;
                        btn.textContent = "Ingresar";
                    }
                }
            } catch (error) {
                // Error de conexión con el servidor
                showAlert("No se pudo conectar con el servidor.");
                console.log("Error de conexión:", error);
            } finally {
                // Rehabilitar botón sin importar el resultado
                btn.disabled    = false;
                btn.textContent = "Ingresar";
            }
        });
    });
</script>

<style>

    /* Caja de alerta base, oculta por defecto */
    .mb-alert {
        display: none;
        padding: 10px 12px;
        font-size: 12px;
        letter-spacing: 1px;
        margin-bottom: 1rem;
        text-align: center;
        border: 1px solid;
    }

    /* Alerta de error */
    .mb-alert.error {
        background: var(--error-bg);
        color: var(--primary-dark);
        border-color: var(--primary);
    }

    /* Alerta de éxito */
    .mb-alert.success {
        background: var(--success-bg);
        color: var(--success);
        border-color: var(--success);
    }

    /* Separador entre login normal y social */
    .mb-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 1.2rem 0;
        color: var(--text-hint);
        font-size: 11px;
        letter-spacing: 2px;
    }

    .mb-divider::before,
    .mb-divider::after {
        content: '';
        flex: 1;
        border-top: 1px solid var(--border);
    }

    /* Botón de login con Google */
    .mb-google {
        width: 100%;
        padding: 10px;
        background: transparent;
        border: 1px solid var(--border);
        font-size: 12px;
        letter-spacing: 1px;
        color: var(--text-muted);
        cursor: pointer;
        text-transform: uppercase;
        font-family: Arial, sans-serif;
        transition: border-color 0.2s, color 0.2s;
    }

    /* Hover del botón de Google */
    .mb-google:hover {
        border-color: var(--primary);
        color: var(--primary);
    }

    /* Pie del formulario con link de recuperación */
    .mb-footer {
        text-align: center;
        margin-top: 1.2rem;
        font-size: 11px;
    }

</style>