---
import Button from "../../components/ui/Button.astro";
import InputMail from "../../components/ui/InputMail.astro";
import Alert from "../ui/Alert/Alert.astro";
---

<p class="mb-subtitle bold font">Recuperacíon de contraseña</p>
<p class="mb-subtitle">Ingresa la Nueva contraseña</p>

<Alert/>

<InputMail
            label="Contraseña"
            placeholder="••••••••"
            id="mb-password"
            type="password"
         />

<p class="mb-subtitle">Repetí la contraseña</p>

<InputMail
            label="Contraseña"
            placeholder="••••••••"
            id="mb-second-password"
            type="password"
         />

<Button nombre="Confirmar"/>

<style>
    .bold{ 
        font-weight: bold;
    }
    .font{
        font-size: 18px;
    }

</style>



<script>
    import {showAlert} from "../ui/Alert/Alert.ts";
    const btn     = document.getElementById("mb-btn") as HTMLButtonElement;
    const savedEmail = sessionStorage.getItem("userEmail"); 
    
    btn.addEventListener("click", async () => {

        // Obtener valores de los campos
        const pwd    = (document.getElementById("mb-password") as HTMLInputElement).value.trim();
        const secondPwd    = (document.getElementById("mb-second-password") as HTMLInputElement).value.trim();

        if(pwd == secondPwd ){
            try{
                const response = await fetch("http://127.0.0.1:8000/api/updt-pwd", {
                        method: "post",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ "email": savedEmail, "pwd": pwd})
                });
                if (response.ok == true) {
                    showAlert("Contraseña actualizada correctamente.", false);
                    window.location.href = "/";
                }

            }finally{}
        }else{
            showAlert("Las contraseñas no coinciden.");
        
        }
    });
</script>